# ---------------------------------------------------------------------------
# N.A.V. backend configuration. Copy to backend/.env, or export these.
# Everything has a working default; nothing here is required to run the demo.
# ---------------------------------------------------------------------------

# Optional. With a key the agent uses OpenAI tool-calling; without one it uses
# the built-in mock agent, which calls exactly the same backend tools.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# auto        live Open-Meteo forecast (free, no key), falling back to the
#             mock provider for any point it cannot cover
# open_meteo  same as auto - the fallback is never removed, because a route
#             usually runs past the forecast horizon
# mock        deterministic synthetic weather only
WEATHER_PROVIDER=auto

# Seconds to wait for Open-Meteo before giving up on a request.
WEATHER_TIMEOUT_SECONDS=6

# SQLite file. Relative paths are resolved from the backend directory.
DATABASE_URL=sqlite:///../data/nav.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

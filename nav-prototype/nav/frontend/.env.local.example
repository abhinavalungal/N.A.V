# Backend API. Change only if you run uvicorn on another host or port.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: a MapLibre style URL (any free style works, e.g. an OpenFreeMap
# style). Leave empty to use the bundled offline chart style, which needs no
# network access and no API key.
NEXT_PUBLIC_MAP_STYLE_URL=

{
  "name": "nav",
  "version": "0.1.0",
  "private": true,
  "description": "N.A.V. - Nautical Agentic Navigator",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nav/web",
    "build": "npm run build --workspace=@nav/web",
    "start": "npm run start --workspace=@nav/web",
    "lint": "npm run lint --workspace=@nav/web",
    "typecheck": "npm run typecheck --workspace=@nav/shared-types && npm run typecheck --workspace=@nav/web"
  },
  "engines": {
    "node": ">=20"
  }
}

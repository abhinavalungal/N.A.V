# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every value below is read at runtime; nothing is hard-coded in source.

# --- Application ------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO

# --- Ports (host side) ------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database ---------------------------------------------------------------
POSTGRES_USER=nav
POSTGRES_PASSWORD=nav
POSTGRES_DB=nav
# Used when running the API outside Docker; compose builds its own value.
DATABASE_URL=postgresql+asyncpg://nav:nav@localhost:5432/nav

# --- Cache / broker ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Security ---------------------------------------------------------------
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# --- Providers --------------------------------------------------------------
# Defaults keep the whole stack offline and free to run.
LLM_PROVIDER=mock                  # mock | ollama | openai | anthropic
LLM_MODEL=mock-model
LLM_BASE_URL=                      # e.g. http://localhost:11434 for Ollama
LLM_API_KEY=                       # only for hosted providers; leave empty
WEATHER_PROVIDER=mock              # mock | open_meteo
ROUTING_PROVIDER=mock              # mock | searoute
WEATHER_API_KEY=
ROUTING_API_KEY=

# --- Agent guardrails (enforced from Phase 5) -------------------------------
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=120
NAV_AGENT_PROMPT_VERSION=1.0.0

# --- Object storage (Phase 9/10) --------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Web --------------------------------------------------------------------
# Server-side base URL the console uses to reach the API.
API_INTERNAL_URL=http://localhost:8000

# Everything here has a working default. Copy to .env only when you want to
# change something - `docker compose up --build` runs without this file.
# .env is git-ignored and must never be committed.

# --- Application ------------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
LOG_LEVEL=INFO

# --- Ports (host side) ------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database ---------------------------------------------------------------
POSTGRES_USER=nav
POSTGRES_PASSWORD=nav
POSTGRES_DB=nav
# Only needed when running the API outside Docker; compose builds its own.
# A managed `postgresql://` URL is accepted and rewritten for asyncpg.
DATABASE_URL=postgresql+asyncpg://nav:nav@localhost:5432/nav

# --- Cache / broker ---------------------------------------------------------
# Optional. Leave unset and readiness reports redis as NOT_CONFIGURED instead
# of failing. Required from Phase 4, when optimisation runs move to the worker.
REDIS_URL=redis://localhost:6379/0

# --- Web --------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:8000

# --- CORS -------------------------------------------------------------------
# The console calls the API server-side, so this only matters once something
# calls the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Providers --------------------------------------------------------------
# Defaults keep the whole stack offline and free to run.
LLM_PROVIDER=mock                  # mock | ollama | openai | anthropic
LLM_MODEL=mock-model
LLM_BASE_URL=                      # e.g. http://localhost:11434 for Ollama
LLM_API_KEY=                       # only for hosted providers; leave empty
WEATHER_PROVIDER=mock              # mock | open_meteo
ROUTING_PROVIDER=mock              # mock | searoute
WEATHER_API_KEY=
ROUTING_API_KEY=

# --- Agent guardrails (enforced from Phase 5) -------------------------------
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=120
NAV_AGENT_PROMPT_VERSION=1.0.0

# Authentication (Phase 1) and object storage (Phase 9) add their own settings
# when they are built. Nothing reads them yet, so nothing to configure here.
